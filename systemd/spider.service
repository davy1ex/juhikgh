[Unit]
Description=Spider robot web control panel
After=network-online.target spider-ap.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=i2c gpio
WorkingDirectory=@PROJECT@
ExecStart=@PROJECT@/start.sh
Restart=on-failure
RestartSec=5
Environment=SPIDER_DEBUG=0

[Install]
WantedBy=multi-user.target
